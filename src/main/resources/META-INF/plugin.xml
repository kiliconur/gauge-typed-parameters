<idea-plugin>
  <!-- id / name / description / version / idea-version are injected by
       intellijPlatform.pluginConfiguration in build.gradle.kts (patchPluginXml). -->

  <!-- Core platform + Java PSI (PsiMethod, PsiParameter, PsiEnumConstant). -->
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.java</depends>

  <!-- REQUIRED dependency on the existing Gauge plugin.
       Its jars are provided by the IDE at run time; nothing is bundled here. -->
  <depends>com.thoughtworks.gauge</depends>

  <resource-bundle>messages.GaugeTypedParametersBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Both Gauge languages, exactly as the Gauge plugin registers them itself:
         "Specification" for .spec files and "Concept" for .cpt files. -->
    <completion.contributor
        language="Specification"
        implementationClass="com.company.gauge.typed.completion.GaugeTypedParameterCompletionContributor"
        order="first"/>

    <completion.contributor
        language="Concept"
        implementationClass="com.company.gauge.typed.completion.GaugeTypedParameterCompletionContributor"
        order="first"/>

    <!-- One inspection for both languages: registering it twice would show two identical
         entries in Settings | Inspections. It bails out on the first line of buildVisitor for
         any file that is not Gauge PSI. -->
    <localInspection
        implementationClass="com.company.gauge.typed.inspection.GaugeTypedParameterInspection"
        bundle="messages.GaugeTypedParametersBundle"
        key="inspection.typed.parameter.display.name"
        groupBundle="messages.GaugeTypedParametersBundle"
        groupKey="inspection.group.name"
        shortName="GaugeTypedParameterValue"
        enabledByDefault="true"
        level="WARNING"/>
  </extensions>
</idea-plugin>
